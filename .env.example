NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NWS_USER_AGENT=ghl-tenant-bridge (contact: you@example.com)

# GHL OAuth (Marketplace app). Credentials come from the Developer Portal at
# MANAGE -> Secrets -> Client Keys. The SECRET IS SHOWN ONCE.
# client_id shape: <appId>-<8 chars>   client_secret shape: a UUID
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=
GHL_API_VERSION=2021-07-28

# Shared secret for the UNSIGNED workflow-webhook fallback path. Unset means the
# receiver rejects that path entirely, which is deliberate.
GHL_WORKFLOW_SECRET=
GHL_WORKFLOW_SECRET_HEADER=x-bridge-secret
